# Platform API / database
# Required for migrations and the public platform API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Supabase management credentials are only needed for Supabase CLI/CI. The
# running API uses DATABASE_URL and does not use anon or service-role keys.
SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_REF
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# The browser origin allowed to call the platform API.
PLATFORM_ORIGIN=http://localhost:5173

# Required for confidential strategist target submission. The public key comes
# from the attested TEE endpoint; do not put a TEE private key here.
PLATFORM_TEE_URL=https://TEE-INGRESS-ENDPOINT
PLATFORM_TEE_ENCRYPTION_PUBLIC_KEY=

# Monad testnet. RPC is used by the indexer and vault deployment script.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Local deployment only. Must be a 0x-prefixed 32-byte EVM private key with
# Monad testnet MON for gas. Never set this in Vercel or browser variables.
MONAD_TESTNET_PRIVATE_KEY=
# Optional override for the shared-vault deposit asset. Defaults to Monad
# Testnet AUSD. The deployed vault address is recorded in platform_settings.
PLATFORM_CASH_TOKEN_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Set to the operator address in the deployed Phala attestation.
PLATFORM_OPERATOR_ADDRESS=

# Public browser build setting. Leave as /api when the Vercel API is co-hosted.
VITE_PLATFORM_API_BASE=/api

# Vercel deployment automation only. Vercel runtime configuration belongs in
# the Vercel project environment, not in browser-visible VITE_ variables.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Required only when starting deploy/tee/compose.template.yaml on the TEE host.
# MM_TEE_CONFIG_JSON must be the encrypted configuration accepted by Phala.
MM_TEE_IMAGE=registry.example/mm-zkquant-tee@sha256:REPLACE_WITH_IMAGE_DIGEST
MM_TEE_CONFIG_JSON=

# Phala Cloud control-plane credential used by deploy-platform-worker.mjs.
# CLI login credentials are also supported for Vercel and Supabase management.
PHALA_API_TOKEN=

# Optional strategist client credential, used by scripts/submit-strategy.mjs.
# Issue it through the strategist console. Never expose in VITE_ variables.
MMQ_API_TOKEN=
