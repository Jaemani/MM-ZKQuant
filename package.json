{
  "name": "mm-alpha-fund-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node src/server/http.js",
    "build": "vite build",
    "start": "node src/server/http.js",
    "test": "node --test tests/*.test.js tests/protocol-v1/*.test.mjs",
    "prove:mvp": "node scripts/prove-omnibus.mjs",
    "test:core": "node --test tests/engine.test.js tests/service.test.js tests/protocol.test.js",
    "chain:demo": "node scripts/chain-demo.mjs",
    "verify:receipt": "node scripts/verify-receipt.mjs",
    "pilot": "node scripts/pilot.mjs",
    "pilot:local": "node scripts/pilot.mjs local",
    "pilot:market": "node scripts/pilot.mjs market",
    "pilot:provider": "node scripts/pilot-provider.mjs",
    "prove:legacy": "node scripts/prove-mvp.mjs",
    "test:pilot": "node --test tests/pilot-*.test.js",
    "prove:pilot": "node scripts/prove-pilot.mjs",
    "prove:sleeves": "node scripts/prove-sleeves.mjs",
    "prove:omnibus": "node scripts/prove-omnibus.mjs",
    "prove:omnibus:testnet": "node scripts/prove-omnibus.mjs --testnet",
    "verify:omnibus": "node scripts/verify-omnibus.mjs",
    "prove:external": "node scripts/run-external-proof.mjs",
    "verify:tee": "node scripts/verify-tee.mjs",
    "test:integration": "node --test tests/integration-security.test.js",
    "build:zk": "node scripts/build-zk.mjs",
    "prove:zk": "node scripts/run-external-proof.mjs --zk",
    "verify:zk": "node scripts/verify-zk-evidence.mjs",
    "test:protocol": "node --test tests/protocol-v1/*.test.mjs",
    "verify:protocol": "node scripts/verify-protocol-vectors.mjs",
    "typecheck:protocol": "tsc -p protocol/ts/tsconfig.json",
    "test:reference": "cargo test --locked -p metropolis-reference",
    "probe:perpl": "node scripts/probe-perpl-readonly.mjs",
    "build:perpl-zk": "node scripts/build-perpl-zk.mjs",
    "prove:perpl": "node scripts/run-perpl-fork.mjs",
    "prove:perpl:zk": "node scripts/run-perpl-fork.mjs --zk",
    "prove:perpl:tee": "node scripts/run-perpl-fork.mjs --tee",
    "prepare:perpl:tee": "node scripts/prepare-perpl-tee.mjs",
    "verify:perpl": "node scripts/verify-perpl-evidence.mjs",
    "prove:perpl:atomic": "node scripts/run-perpl-fork.mjs --atomic"
  },
  "dependencies": {
    "@phala/dstack-sdk": "0.5.8",
    "ethers": "^6.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "solc": "0.8.37"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@foundry-rs/anvil": "1.7.1",
    "@types/node": "22.19.0",
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6",
    "typescript": "5.9.3",
    "vite": "^7.1.5"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "underscore": "1.13.8",
    "ws": "8.21.0"
  }
